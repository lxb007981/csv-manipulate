{
  "name": "csv-manipuate",
  "displayName": "CSV-Manipulate",
  "description": "Get/Set a cell's value in a csv file using row/column names.",
  "version": "0.1.0",
  "publisher": "lxb007981",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxb007981/csv-manipulate"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.getCell",
        "title": "Get Cell"
      },
      {
        "command": "extension.setCell",
        "title": "Set Cell"
      }
    ],
    "configuration": {
      "title": "CSV-Manipulate",
      "properties": {
        "csv-manipulate.separator": {
          "type": "string",
          "default": ",",
          "description": "Separator of CSV"
        },
        "csv-manipulate.trimEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Trim the input string before getting or setting the cell. This option is ignored if a space is used as the separator."
        },
        "csv-manipulate.caseInsensitive": {
          "type": "boolean",
          "default": true,
          "description": "search row/col names case insensitively."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "csv-manipulate",
          "title": "CSV-Manipulate",
          "icon": "resources/csv-manipulate-icon.svg"
        }
      ]
    },
    "views": {
      "csv-manipulate": [
        {
          "type": "webview",
          "id": "csv-manipulate-view",
          "name": "CSV-Manipulate View"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -watch -p ./",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^20",
    "@types/vscode": "^1.73.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
